# Caddy tự xin chứng chỉ Let's Encrypt cho tên miền này và tự chuyển HTTP sang HTTPS.
{$DOMAIN} {
	encode zstd gzip

	reverse_proxy app:8080

	# Vài header cơ bản. HSTS do Caddy tự thêm khi đã chạy HTTPS.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}
