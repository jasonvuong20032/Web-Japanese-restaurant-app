<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591: không bắt buộc XML comment cho mọi thành phần public -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!--
      Phải để false: ở chế độ invariant, string.Normalize(FormD) không tách được dấu tổ hợp,
      khiến hàm bỏ dấu tiếng Việt trong DishService thành vô tác dụng và gõ "ca hoi" sẽ
      không tìm ra "cá hồi".
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

</Project>
